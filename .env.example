# ═══════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════
POSTGRES_USER=tabela
POSTGRES_PASSWORD=tabela
POSTGRES_DB=tabela
DATABASE_URL=postgres://tabela:tabela@db:5432/tabela

# ═══════════════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════
# PIN da chefia — autoriza APAGAR e EDITAR alertas de chefia
# Sem CHEFIA_PIN definido, exclusões/edições ficam BLOQUEADAS (fail-closed).
# Rotação: coloque o novo em CHEFIA_PIN e o antigo em CHEFIA_PIN_PREV
# (ambos válidos), avise a equipe, e depois esvazie CHEFIA_PIN_PREV.
# ═══════════════════════════════════════════════════════════════
CHEFIA_PIN=
CHEFIA_PIN_PREV=

# ═══════════════════════════════════════════════════════════════
# Telegram — BOT REGULADOR (mesmo bot do tabela-notifier).
#
# TELEGRAM_ADMIN_CHAT_ID  → privado do admin: alerta de bloqueio de IP,
#                           PIN rotacionado, comandos /resetpin e /bloqueados.
# TELEGRAM_REGULADORES_CHAT_ID → grupo dos reguladores: avisos de UPA restrita
#                           (a cada 2h, ancorado em 07:00/19:00) e /upas.
#                           Vazio = avisos no grupo desligados (fail-soft).
#
# Não confundir com o bot Plantões SAMU (~/plantoes): outro token, outro grupo.
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_REGULADORES_CHAT_ID=

# ═══════════════════════════════════════════════════════════════
# Web
# ═══════════════════════════════════════════════════════════════
WEB_PORT=3001

# ═══════════════════════════════════════════════════════════════
# Frontend (dev only — em prod o nginx faz proxy)
# ═══════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:3000/tabela/api
VITE_WS_URL=ws://localhost:3000/tabela/ws
