# ═══════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════
POSTGRES_USER=tabela
POSTGRES_PASSWORD=tabela
POSTGRES_DB=tabela
DATABASE_URL=postgres://tabela:tabela@db:5432/tabela

# ═══════════════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════
# PIN da chefia — autoriza APAGAR e EDITAR alertas de chefia
# Sem CHEFIA_PIN definido, exclusões/edições ficam BLOQUEADAS (fail-closed).
# Rotação: coloque o novo em CHEFIA_PIN e o antigo em CHEFIA_PIN_PREV
# (ambos válidos), avise a equipe, e depois esvazie CHEFIA_PIN_PREV.
# ═══════════════════════════════════════════════════════════════
CHEFIA_PIN=
CHEFIA_PIN_PREV=

# ═══════════════════════════════════════════════════════════════
# Telegram — alerta de bloqueio de IP e entrega do PIN rotacionado
# vão para o PRIVADO do admin (não para o grupo). Mesmo bot do notifier.
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ═══════════════════════════════════════════════════════════════
# Web
# ═══════════════════════════════════════════════════════════════
WEB_PORT=3001

# ═══════════════════════════════════════════════════════════════
# Frontend (dev only — em prod o nginx faz proxy)
# ═══════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:3000/tabela/api
VITE_WS_URL=ws://localhost:3000/tabela/ws
